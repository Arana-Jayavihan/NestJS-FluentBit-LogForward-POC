# Terraform state files
*.tfstate
*.tfstate.*

# Terraform lock file (can be committed, but often ignored)
.terraform.lock.hcl

# Terraform directory
.terraform/

# Crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc
