# =============================================================================
# Terraform Variables Example
# Copy this file to terraform.tfvars and customize as needed
# =============================================================================

# Kubernetes Configuration
kubeconfig_path    = "~/.kube/config"
kubeconfig_context = "minikube"

# Namespace Configuration
app_namespace        = "app"
monitoring_namespace = "monitoring"

# NestJS Application Configuration
nestjs_image_repository  = "nest-api"
nestjs_image_tag         = "latest"
nestjs_image_pull_policy = "Never"  # Use "Never" for local minikube images
nestjs_replica_count     = 1
nestjs_service_port      = 3000

# FluentBit Configuration
fluentbit_chart_version = "0.49.0"
fluentbit_image_tag     = "3.2.2"
fluentbit_replica_count = 1
fluentbit_tcp_port      = 9000

# =============================================================================
# Azure Log Analytics Configuration (Optional)
# Uncomment and fill in to enable Azure output
# =============================================================================

# azure_enabled       = true
# azure_client_id     = "your-client-id"
# azure_client_secret = "your-client-secret"
# azure_tenant_id     = "your-tenant-id"
# azure_dce_url       = "https://your-dce.ingest.monitor.azure.com"
# azure_dcr_id        = "dcr-xxxxxxxxxxxxxxxx"
# azure_table_name    = "CustomLogs_CL"
